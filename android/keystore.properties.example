# Per-developer release-signing keys for aka Alarm.
#
# Copy this file to `keystore.properties` (gitignored) and fill in your values.
# Generate the keystore once with:
#
#   keytool -genkey -v \
#     -keystore aka-alarm-upload.jks \
#     -keyalg RSA -keysize 2048 -validity 36500 \
#     -alias aka-alarm-upload
#
# Move the .jks file somewhere safe — losing it means losing the ability
# to ship updates to the same Play Store listing.

storeFile=/absolute/path/to/aka-alarm-upload.jks
storePassword=
keyAlias=aka-alarm-upload
keyPassword=
